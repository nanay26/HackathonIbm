# ── Langflow ──────────────────────────────────────────────────────────────────
LANGFLOW_BASE_URL=https://your-langflow-host
LANGFLOW_API_KEY=your-api-key-here
LANGFLOW_FLOW5_ID=your-flow5-uuid
LANGFLOW_MCP_URL=https://your-langflow-host/api/v1/mcp/project/your-project-id/streamable
# Set to "true" to return fixture instead of calling Langflow (dev only)
LANGFLOW_MOCK=false

# ── Review job limits ─────────────────────────────────────────────────────────
REVIEW_TIMEOUT_SECONDS=360
MAX_INPUT_CHARS=200000
MAX_UPLOAD_MB=10
MAX_CONCURRENT_REVIEWS=1
JOB_TTL_SECONDS=1800

# ── Rate limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_HOURLY=2
RATE_LIMIT_DAILY=4
GLOBAL_DAILY_REVIEW_CAP=100

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Frontend (Next.js public) ─────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
